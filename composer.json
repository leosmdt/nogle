{
    "name": "nogle/clientes",
    "description": "Desafio prático Nogle: CRUD de clientes em uma tela, em PHP puro com MySQL.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Nogle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nogle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php bin/serve.php --seed",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
